# Anon / publishable key only — never put the service role key here (browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase CLI (optional): npm run db:login, or set for non-interactive use
# Create a token: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
# Backend API (Express on Render/Railway, etc.). Required in production builds — see src/config/env.js.
# Used for checkout, availability, GET /api/boats / GET /api/captains-log fallbacks, and GET /api/admin/verify when the browser cannot query the admins table after login.
# Local dev: Vite proxy also serves /api → localhost:3001 when you omit this.
VITE_API_URL=http://localhost:3001

# Contact page (digits ok for phone, e.g. 8035421761)
VITE_CONTACT_PHONE=
VITE_BUSINESS_NAME=
VITE_CONTACT_EMAIL=
