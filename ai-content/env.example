SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Preferred name (service role, server-side only):
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Legacy alias (still supported if SUPABASE_SERVICE_ROLE_KEY is unset):
# SUPABASE_KEY=your_service_role_key

# YouTube (optional): unlimited YOUTUBE_CHANNEL_<NAME>=UC…|Handle or UC… or @handle
# YOUTUBE_CHANNEL_SPACEX=UCtI0Hodo5o5dUb67FeUjDeA|SpaceX
# YOUTUBE_CHANNEL_BOATSETTER=UCxxxxxxxxxxxxxxxxxxxxxx|Boatsetter
# Legacy YOUTUBE_CHANNEL_IDS is ignored; use one env key per channel.
# YOUTUBE_HANDLES=boatsetter,boatsdotcom,floridafishing

# Captain's Log pipeline
# CAPTAINS_LOG_IMAGE_BUCKET=your-public-bucket
# OLLAMA_TIMEOUT_SEC=90
# Optional: cap completion tokens (0 = rewrite.py uses hub vs standard defaults, typically 3200 / 2400)
# OLLAMA_NUM_PREDICT=0
# OLLAMA_MAX_RETRIES=3
# FRESHNESS_MAX_AGE_DAYS=21
# PIPELINE_LOG_OLLAMA_MODEL=1
# FLORIDA_TODAY_SPACE_RSS=https://rssfeeds.floridatoday.com/space/
# FLORIDA_TODAY_MAIN_RSS=https://www.floridatoday.com/rss/
# SPACECOAST_DAILY_RSS=https://spacecoastdaily.com/feed/
# BOATING_MAG_RSS=https://www.boatingmag.com/feed/
# SPORTFISHING_MAG_RSS=https://www.sportfishingmag.com/feed/
# NEWS_JOURNAL_ONLINE_RSS=https://www.news-journalonline.com/rss/

# Optional overrides
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=phi3:mini
# IMAGE_FALLBACK=/fallback.jpg
# NASA_NEWS_URL=https://www.nasa.gov/news/
# SCRAPER_POOL_PER_SOURCE=12
# PIPELINE_TOP_N=5
# Per-URL RSS logs: 0 = quiet (default for server generate-content), 1 = full CHECKING URL / RELEVANCE lines
# PIPELINE_VERBOSE=1
# Full SEO (default): leave unset or PIPELINE_FAST=0 — SEO hub outline, full HTML fetch, normal Ollama budget.
# Fast dev runs only: PIPELINE_FAST=1 (RSS-only body, no SEO hub, shorter timeouts, fewer articles)
# PIPELINE_FAST=0
# OLLAMA_TIMEOUT_SEC=50
# OLLAMA_STREAM_ATTEMPTS=1
