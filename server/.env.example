PORT=3001

# Minimum lead-time before trip start (hours). Applies to availability + checkout validation.
# Same-day bookings earlier than now + this window are blocked.
# BOOKING_MIN_LEAD_HOURS=2

# OpenWeatherMap (server-only; used by weatherService + bioluminescence-check)
WEATHER_API_KEY=

# Stormglass (tide extremes — required for GET /api/bioluminescence; no partial glow score without live tide)
STORMGLASS_API_KEY=

# Bioluminescence: lagoon/sea surface temperature from Open-Meteo Marine (no API key; cached server-side).
# Falls back to air-based estimate if marine fetch fails.

# Max wait (ms) for OpenWeather + Stormglass together in glow pipeline (default 30000). Moon/scoring are not timed here.
# BIO_REQUEST_TIMEOUT_MS=30000

# Launch Library 2 — upcoming launches (rocket-check)
# ROCKET_API_URL=https://ll.thespacedevs.com/2.2.0/launch/upcoming/

# Ollama (local LLM for advisory summaries only — optional; falls back to message if down)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=mistral

# Node Ollama: warn if more than N calls within window (rocket advisory, etc.). Glow does not call Ollama.
# OLLAMA_NODE_WARN_THRESHOLD=8
# OLLAMA_NODE_WARN_WINDOW_MS=60000

# Supabase (service role — server only; never expose in frontend)
# Same project URL as the frontend; service role is server-only (never in Vite env)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: slow networks to Supabase (auth + REST) — node-fetch request timeout ms (default 90000)
# SUPABASE_FETCH_TIMEOUT_MS=90000
# Optional: underlying HTTP(S) socket timeout ms (default 120000)
# SUPABASE_BODY_TIMEOUT_MS=120000

RESEND_API_KEY=
# Must be a verified sender in Resend (e.g. Booking <confirm@yourdomain.com>)
# Alerts use the same from-address unless you split in Resend dashboard
RESEND_FROM_EMAIL=

# Hourly cron: PERFECT bio + rocket conditions → subscribers (SMS + email). Set to 1 to disable.
# DISABLE_CONDITION_MONITOR=1

# Receives internal alert when a booking confirmation is sent
ADMIN_EMAIL=

# Used in contact inquiry email subject: "New Inquiry - {BUSINESS_NAME}"
BUSINESS_NAME=

# Public site URL for verification email links (e.g. https://launchzonecharters.com)
# FRONTEND_URL is accepted as an alias
APP_PUBLIC_URL=

# Stripe (deposit Checkout — optional; if unset, booking skips Checkout and uses /booking-received only)
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks → endpoint → Signing secret
# STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio (verification SMS; optional — skipped if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Shared secret for cron hooks (Authorization: Bearer … or ?secret=)
# - GET /api/cron/trip-insurance-reminders (every 15 min in-process)
# - GET /api/cron/waivers-docs-reminders (every 6 hours in-process; missing license/insurance)
# CRON_SECRET=

# Production: FRONTEND_URL / APP_PUBLIC_URL / CORS_ORIGIN are merged for CORS; www and apex are auto-mirrored.
# Add explicit entries if you use preview deploy URLs or a separate admin origin.
# CORS_ORIGIN=https://preview-xxx.vercel.app

# Python for POST /api/generate-content (Captain's Log pipeline). Default: python (Windows) / python3
# PYTHON_PATH=C:\Python311\python.exe
# GENERATE_CONTENT_TIMEOUT_MS=60000
