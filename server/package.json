{
  "name": "launch-zone-server",
  "private": true,
  "version": "1.0.0",
  "description": "API for Launch Zone Rentals (booking confirmation email)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "node scripts/ensure-captains-log-venv.js",
    "build": "npm run setup:captains-log",
    "setup:captains-log": "node scripts/ensure-captains-log-venv.js",
    "test:lead-time": "node tests/bookingLeadTime.test.js",
    "test:booking-datetime-range": "node tests/bookingDateTimeRange.test.js",
    "test:staff-booking-duration": "node tests/staffBookingDuration.test.js",
    "test:admin-login-redirect": "node tests/adminLoginRedirect.test.js",
    "test:pre-trip": "node tests/preTripSubmissionGuard.test.js && node --test tests/preTripMatchSuggestions.test.js",
    "test:boat-capacity": "node tests/boatSafetyCapacity.test.js && node --test tests/boatCapacityService.test.js",
    "test:admin-smoke": "node ../scripts/adminSmokeTest.mjs",
    "test:ollama": "node --test tests/ollamaClient.test.js"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "luxon": "^3.7.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "pdfkit": "^0.17.2",
    "resend": "^4.0.1",
    "stripe": "^17.7.0",
    "twilio": "^5.13.1",
    "undici": "^6.24.1"
  }
}
